# Generated files: collapsed in diffs, and kept out of language stats and of
# whatever PR-size metrics read this attribute. Marks output only.

package-lock.json linguist-generated=true

# The committed action bundle. A JS action has to ship its build, so this is
# the one generated file that cannot be gitignored -- at ~30k lines it would
# otherwise read as the bulk of every diff that touches src/.
dist/index.cjs linguist-generated=true
